color\" data-source=\"species\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Species</h3>\n\t\n\t<div class=\"pi-data-value pi-font\">Human</div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"status\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Status</h3>\n\t\n\t<div class=\"pi-data-value pi-font\">Alive</div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"occupation\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Occupation</h3>\n\t\n\t<div class=\"pi-data-value pi-font\">Head of the <a href=\"/wiki/White_Mask\" title=\"White Mask\">White Masks</a> of the <a href=\"/wiki/House_of_Slaughter\" title=\"House of Slaughter\">House of Slaughter</a></div>\n</div>\n\n</section>\n<section class=\"pi-item pi-group pi-border-color\">\n\t<h2 class=\"pi-item pi-header pi-secondary-font pi-item-spacing pi-secondary-background\">The Order of St. George</h2>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"house\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">House</h3>\n\t\n\t<div class=\"pi-data-value pi-font\"><a href=\"/wiki/House_of_Slaughter\" title=\"House of Slaughter\">House of Slaughter</a></div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"mask\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Mask</h3>\n\t\n\t<div class=\"pi-data-value pi-font\"><span typeof=\"mw:File\"><span><img alt=\"White Mask\" src=\"https://static.wikia.nocookie.net/something-is-killing-the-children/images/5/52/White_Mask.png/revision/latest/scale-to-width-down/50?cb=20241130215853\" decoding=\"async\" loading=\"lazy\" width=\"50\" height=\"27\" class=\"mw-file-element\" data-image-name=\"White Mask.png\" data-image-key=\"White_Mask.png\" data-relevant=\"1\" /></span></span> — <a href=\"/wiki/White_Mask\" title=\"White Mask\">White</a><br /><span typeof=\"mw:File\"><span><img alt=\"Black Mask\" src=\"https://static.wikia.nocookie.net/something-is-killing-the-children/images/d/df/Black_Mask.png/revision/latest/scale-to-width-down/50?cb=20241130215907\" decoding=\"async\" loading=\"lazy\" width=\"50\" height=\"27\" class=\"mw-file-element\" data-image-name=\"Black Mask.png\" data-image-key=\"Black_Mask.png\" data-relevant=\"1\" /></span></span> — <a href=\"/wiki/Black_Mask\" title=\"Black Mask\">Black</a> <small>(formerly)</small></div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"position\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Position</h3>\n\t\n\t<div class=\"pi-data-value pi-font\">Monster hunter<br />Council member</div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"totem\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Totem</h3>\n\t\n\t<div class=\"pi-data-value pi-font\">Rabbit Toy</div>\n</div>\n\n</section>\n<section class=\"pi-item pi-group pi-border-color\">\n\t<h2 class=\"pi-item pi-header pi-secondary-font pi-item-spacing pi-secondary-background\">Relationships</h2>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"affiliation\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Affiliation</h3>\n\t\n\t<div class=\"pi-data-value pi-font\"><a href=\"/wiki/The_Order_of_St._George\" title=\"The Order of St. George\">The Order of St. George</a></div>\n</div>\n\n</section>\n<section class=\"pi-item pi-group pi-border-color\">\n\t<h2 class=\"pi-item pi-header pi-secondary-font pi-item-spacing pi-secondary-background\">Appearances</h2>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"first_appearance\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">First Appearance</h3>\n\t\n\t<div class=\"pi-data-value pi-font\"><a href=\"/wiki/Something_Is_Killing_the_Children_5\" title=\"Something Is Killing the Children 5\"><i>Something Is Killing the Children</i> #5</a></div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"last_appearance\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Last Appearance</h3>\n\t\n\t<div class=\"pi-data-value pi-font\"><a href=\"/wiki/Book_of_Cutter_1\" title=\"Book of Cutter 1\"><i>Book of Cutter</i></a></div>\n</div>\n\n</section>\n</aside>\n\n<p class=\"mw-empty-elt\"></p>\n<blockquote class=\"pull-quote\">\n\t<div class=\"pull-quote&#95;&#95;text\">I haven't been a <a href=\"/wiki/Black_Mask\" title=\"Black Mask\">Black Mask</a> in a very long time. But I trained side by side with <a href=\"/wiki/Jessica_Slaughter\" title=\"Jessica Slaughter\">the woman who taught you everything you know</a>. If took me less than an <i>hour</i> to find you after reaching <span class=\"new\" title=\"Tribulation (page does not exist)\" data-uncrawlable-url=\"L3dpa2kvVHJpYnVsYXRpb24/YWN0aW9uPWVkaXQmcmVkbGluaz0x\">Tribulation</span>. And if you think there is any place in this rotten world you could hide from me... then you aren't as smart as I <i>know</i> you are.</div>\n\t<p style=\"text-align: right\"><cite>—Cecilia Slaughter to <a href=\"/wiki/Erica_Slaughter\" title=\"Erica Slaughter\">Erica Slaughter</a>, <a href=\"/wiki/Something_Is_Killing_the_Children_32\" title=\"Something Is Killing the Children 32\"><i>Something Is Killing the Children</i> #32</a></cite></p>\n</blockquote>\n<p><b>Cecilia Slaughter</b> is the Head of the <a href=\"/wiki/White_Mask\" title=\"White Mask\">White Masks</a> of the <a href=\"/wiki/House_of_Slaughter\" title=\"House of Slaughter\">House of Slaughter</a>, under the <a href=\"/wiki/Order_of_St._George\" class=\"mw-redirect\" title=\"Order of St. George\">Order of St. George</a>. The next-in-line to be the <a href=\"/wiki/House_Dragon\" class=\"mw-redirect\" title=\"House Dragon\">Dragon</a> of the House of Slaughter, Cecilia was formerly a <a href=\"/wiki/Black_Mask\" title=\"Black Mask\">Black Mask</a> trainee before switching into the White Masks and quickly rising in position to the House Council. \n</p>\n\n<h2><span class=\"mw-headline\" id=\"Physical_appearance\">Physical appearance</span></h2>\n<p>Cecilia is a young Caucasian woman with red eyes and short, white hair.\n</p>\n<h2><span class=\"mw-headline\" id=\"Appearances\">Appearances</span></h2>\n<h3><span class=\"mw-headline\" id=\"Something_Is_Killing_the_Children\"><i><a href=\"/wiki/Something_Is_Killing_the_Children_(comic_series)\" title=\"Something Is Killing the Children (comic series)\">Something Is Killing the Children</a></i></span></h3>\n<ul><li><a href=\"/wiki/Something_Is_Killing_the_Children_5\" title=\"Something Is Killing the Children 5\">Issue #5</a></li>\n<li><a href=\"/wiki/Something_Is_Killing_the_Children_6\" title=\"Something Is Killing the Children 6\">Issue #6</a></li>\n<li><a href=\"/wiki/Something_Is_Killing_the_Children_11\" title=\"Something Is Killing the Children 11\">Issue #11</a></li>\n<li><a href=\"/wiki/Something_Is_Killing_the_Children_12\" title=\"Something Is Killing the Children 12\">Issue #12</a></li>\n<li><a href=\"/wiki/Something_Is_Killing_the_Children_13\" title=\"Something Is Killing the Children 13\">Issue #13</a></li>\n<li><a href=\"/wiki/Something_Is_Killing_the_Children_14\" title=\"Something Is Killing the Children 14\">Issue #14</a></li>\n<li><a href=\"/wiki/Something_Is_Killing_the_Children_15\" title=\"Something Is Killing the Children 15\">Issue #15</a></li>\n<li><a href=\"/wiki/Something_Is_Killing_the_Children_16\" title=\"Something Is Killing the Children 16\">Issue #16</a></li>\n<li><a href=\"/wiki/Something_Is_Killing_the_Children_17\" title=\"Something Is Killing the Children 17\">Issue #17</a></li>\n<li><a href=\"/wiki/Something_Is_Killing_the_Children_19\" title=\"Something Is Killing the Children 19\">Issue #19</a></li>\n<li><a href=\"/wiki/Something_Is_Killing_the_Children_20\" title=\"Something Is Killing the Children 20\">Issue #20</a></li>\n<li><a href=\"/wiki/Something_Is_Killing_the_Children_23\" title=\"Something Is Killing the Children 23\">Issue #23</a></li>\n<li><a href=\"/wiki/Something_Is_Killing_the_Children_24\" title=\"Something Is Killing the Children 24\">Issue #24</a></li>\n<li><a href=\"/wiki/Something_Is_Killing_the_Children_29\" title=\"Something Is Killing the Children 29\">Issue #29</a></li>\n<li><a href=\"/wiki/Something_Is_Killing_the_Children_31\" title=\"Something Is Killing the Children 31\">Issue #31</a></li>\n<li><a href=\"/wiki/Something_Is_Killing_the_Children_32\" title=\"Something Is Killing the Children 32\">Issue #32</a></li>\n<li><a href=\"/wiki/Something_Is_Killing_the_Children_35\" title=\"Something Is Killing the Children 35\">Issue #35</a></li></ul>\n<h3><span class=\"mw-headline\" id=\"House_of_Slaughter\"><i><a href=\"/wiki/House_of_Slaughter_(comic_series)\" title=\"House of Slaughter (comic series)\">House of Slaughter</a></i></span></h3>\n<ul><li><a href=\"/wiki/House_of_Slaughter_1\" title=\"House of Slaughter 1\">Issue #1</a></li>\n<li><a href=\"/wiki/House_of_Slaughter_2\" title=\"House of Slaughter 2\">Issue #2</a></li>\n<li><a href=\"/wiki/House_of_Slaughter_3\" title=\"House of Slaughter 3\">Issue #3</a></li>\n<li><a href=\"/wiki/House_of_Slaughter_4\" title=\"House of Slaughter 4\">Issue #4</a></li>\n<li><a href=\"/wiki/House_of_Slaughter_5\" title=\"House of Slaughter 5\">Issue #5</a></li>\n<li><a href=\"/wiki/House_of_Slaughter_9\" title=\"House of Slaughter 9\">Issue #9</a></li>\n<li><span class=\"new\" title=\"House of Slaughter 15 (page does not exist)\" data-uncrawlable-url=\"L3dpa2kvSG91c2Vfb2ZfU2xhdWdodGVyXzE1P2FjdGlvbj1lZGl0JnJlZGxpbms9MQ==\">Issue #15</span></li>\n<li><span class=\"new\" title=\"House of Slaughter 16 (page does not exist)\" data-uncrawlable-url=\"L3dpa2kvSG91c2Vfb2ZfU2xhdWdodGVyXzE2P2FjdGlvbj1lZGl0JnJlZGxpbms9MQ==\">Issue #16</span></li>\n<li><span class=\"new\" title=\"House of Slaughter 26 (page does not exist)\" data-uncrawlable-url=\"L3dpa2kvSG91c2Vfb2ZfU2xh